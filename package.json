{
  "name": "magicpnp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "dev:web": "ng serve",
    "build": "npm run build:core && npm run typecheck && ng build",
    "build:web": "ng build",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p packages/core/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.3.0",
    "@magicpnp/core": "*",
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.3",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true
  }
}
